<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Idle.Game</RootNamespace>
    <AssemblyName>IdleLab</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs;Persistence/**/*.cs;Tests/**/*.cs" />
    <ProjectReference Include="Core/Idle.Core.csproj" />
    <ProjectReference Include="Persistence/Idle.Persistence.csproj" />
    <Content Include="Data/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
